---
// Sales, on the shared service layout.
import PaginaServiciu from '../layouts/PaginaServiciu.astro';
import CardUtilaj from '../components/CardUtilaj.astro';
import { utilaje } from '../data/utilaje.mjs';
import { categorii } from '../data/categorii.mjs';
import { firma } from '../data/firma.mjs';
const deVanzare = utilaje.filter((u) => u.vanzare.disponibil);
---
<PaginaServiciu
  title="Utilaje pentru pardoseli de vânzare | DM Technology"
  description="Mașini de șlefuit beton, mașini de sablat, freze și aspiratoare industriale de vânzare, din depozitul DM Technology din Voluntari, lângă București."
  cale="Vânzare"
  h1="Utilaje pentru pardoseli de vânzare"
  lead="Mașini de șlefuit beton, mașini de sablat, freze, aspiratoare industriale și mașini de decopertat, din depozitul nostru din Voluntari, lângă București."
  imagine={{ cheie: 'ref/hero-slefuit-beton', alt: 'Mașină de șlefuit beton de vânzare', pozitie: '64% 50%' }}
  atuuriTitlu="De ce să cumperi de la noi"
  atuuri={[
    { icon: 'lupa', titlu: 'Îl vezi înainte', text: 'Vii în depozit și vezi utilajul pornit.', todo: 'de confirmat' },
    { icon: 'cheie', titlu: 'Service', text: 'Reparații și întreținere după cumpărare.', todo: 'de confirmat' },
    { icon: 'pachet', titlu: 'Consumabile', text: 'Discuri, alice și saci pentru aspirator, din același loc.', todo: 'de confirmat' },
    { icon: 'ceas', titlu: 'Program', text: `${firma.program}, în depozitul din Voluntari.` },
  ]}
  continutTitlu="Utilaje de vânzare"
  continutLink={{ text: 'Toate utilajele', href: '/utilaje/' }}
  etapeTitlu="Cum cumperi, în 4 pași"
  etape={[
    { icon: 'lupa', titlu: 'Alegi utilajul', text: 'Din site sau la telefon, după lucrare și suprafață.' },
    { icon: 'chat', titlu: 'Ceri ofertă', text: 'Pe WhatsApp sau la telefon: preț, disponibilitate, termen.' },
    { icon: 'loc', titlu: 'Îl vezi în depozit', text: 'În Voluntari, lângă București, în timpul programului.', todo: 'de confirmat' },
    { icon: 'camion', titlu: 'Îl iei sau îl livrăm', text: 'Ridici din depozit sau îl primești pe șantier.', todo: 'livrarea de confirmat' },
  ]}
  placiTitlu="Condiții, pe scurt"
  placi={[
    { icon: 'scut', titlu: 'Garanție', text: 'Garanție pentru utilajele vândute.', todo: 'durata de confirmat' },
    { icon: 'chitanta', titlu: 'Factură', text: `Factură de la ${firma.denumireLegala}.` },
    { icon: 'camion', titlu: 'Transport', text: firma.livrare ?? 'Ridici din depozit.', todo: firma.livrare ? null : 'livrarea de confirmat' },
    { icon: 'calendar', titlu: 'Disponibilitate', text: 'Din stoc sau la comandă.', todo: 'de confirmat' },
  ]}
  intrebari={[
    { q: 'Aveți și utilaje second-hand?', a: null, todo: 'De la DM: vindeți și utilaje folosite?' },
    { q: 'Pot încerca utilajul înainte?', a: null, todo: 'De la DM: se poate vedea și porni în depozit?' },
    { q: 'Vindeți și consumabile?', a: null, todo: 'De la DM: ce consumabile aveți în stoc?' },
  ]}
  formTitlu="Cere ofertă de cumpărare"
>
  <div class="grid grid-3">{deVanzare.map((u) => <CardUtilaj u={u} />)}</div>
</PaginaServiciu>
