---
import Foto from './Foto.astro';
interface Props { l: any; prioritar?: boolean }
const { l, prioritar = false } = Astro.props;
---
<a href={`/lucrari/#${l.slug}`} class="card">
  <Foto cheie={l.imagine} alt={l.nume} clasa={l.imagine.startsWith('tiktok/') ? 'poza vertical' : 'poza'} widths={[400, 640, 860]} sizes="(max-width: 700px) 100vw, 420px" pozitie="50% 18%" prioritar={prioritar} />
  <span class="nume">{l.nume}</span>
  <span class="scurt muted">{l.scurt}</span>
  <span class="link btn btn-mic btn-contur">Vezi lucrarea</span>
</a>

<style>
  .card { display: flex; flex-direction: column; gap: 10px; text-decoration: none; }
  .card :global(.poza) { aspect-ratio: 4 / 3; margin-bottom: 4px; }
  /* Vertical TikTok frames: zoom past the black side bars and keep the top of
     the frame, above the caption DM burned into the video. */
  .card :global(.vertical img) { transform: scale(1.22); transform-origin: 50% 0; }
  .nume { font-size: 23px; font-weight: 800; letter-spacing: -0.02em; }
  .scurt { font-size: 16px; line-height: 1.45; }
  .link { align-self: flex-start; margin-top: 4px; }
  .card:hover .nume { text-decoration: underline; text-underline-offset: 5px; }
  @media (max-width: 700px) {
    .card { gap: 8px; }
    .card :global(.poza) { aspect-ratio: 16 / 10; }
    .nume { font-size: 21px; }
    .scurt { font-size: 15.5px; }
  }
</style>
