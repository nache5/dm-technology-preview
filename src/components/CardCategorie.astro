---
import Foto from './Foto.astro';
import Pret from './Pret.astro';
import { dinCategorie } from '../data/utilaje.mjs';

interface Props { c: any; mare?: boolean; prioritar?: boolean }
const { c, mare = false, prioritar = false } = Astro.props;
const preturi = dinCategorie(c.slug).map((u: any) => u.inchiriere.pretZi).filter((p: any) => p);
const minim = preturi.length ? Math.min(...preturi) : null;
---
<a href={`/utilaje/${c.slug}/`} class:list={['card', { mare }]}>
  <Foto
    cheie={c.imagine}
    alt={c.nume}
    clasa="ratio"
    widths={mare ? [480, 720, 960, 1280] : [400, 640, 860]}
    sizes={mare ? '(max-width: 760px) 100vw, 640px' : '(max-width: 600px) 100vw, 420px'}
    prioritar={prioritar}
  />
  <span class="rand">
    <span class="nume">{c.nume}</span>
    <span class="pret muted"><Pret lei={minim} /></span>
  </span>
  <span class="folosire muted">{c.folosire}</span>
</a>

<style>
  .card { display: flex; flex-direction: column; gap: 12px; text-decoration: none; }
  .card :global(.ratio) { aspect-ratio: 3 / 2; }
  .rand { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 4px 12px; }
  .nume { font-size: 21px; font-weight: 700; letter-spacing: -0.015em; }
  .mare .nume { font-size: 25px; letter-spacing: -0.02em; }
  .pret { font-size: 15px; }
  .folosire { font-size: 15.5px; margin-top: -6px; }
  .card:hover .nume { text-decoration: underline; text-underline-offset: 5px; }
  @media (max-width: 700px) {
    .card { gap: 10px; }
    .nume, .mare .nume { font-size: 21px; }
    .folosire { font-size: 15.5px; margin-top: -4px; }
  }
</style>
